# Copy to backend/.env and fill in. Every value here is optional except the LLM
# credentials, and those are only needed for the web chat — the MCP server, the
# REST API and the audit log all run without them.

# --- LLM (OpenAI-compatible endpoint, e.g. a LiteLLM proxy) ---
LLM_API_KEY=
# Proxy root, no /v1 suffix. Leave blank to talk to api.openai.com.
LLM_BASE_URL=
LLM_MODEL=claude-sonnet-4-6
MAX_TOKENS=4096

# --- Service ---
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO

# --- MCP ---
# Where this project's own agent connects. Point it at the GATEWAY, not the
# backend: every consumer goes through :3111 so that all calls are audited.
MCP_GATEWAY_URL=http://127.0.0.1:3111/mcp
# Refuse anything other than MCP 2026-07-28.
#
# Leave this false. mcp-remote - the bridge Claude Desktop and Antigravity use -
# opens with the legacy initialize handshake, and strict mode refuses it with
# -32022, so neither host can connect. SDK v2 serves both revisions from one
# endpoint, so the permissive default costs nothing.
STRICT_PROTOCOL=false

# Let the Control Room's MCP Servers page edit the gateway tool allowlist.
# A browser editing a security policy with no auth is a deliberate trade for a
# localhost PoC; set false to make it read-only.
ALLOW_POLICY_EDIT=true

# --- Observability ---
# Calls from one source separated by more than this many seconds are grouped
# into different episodes. An inferred reading aid, never a conversation id.
EPISODE_IDLE_GAP_S=30
AUDIT_MAX_ROWS=50000
AUDIT_MAX_AGE_DAYS=30

# Override the source-attribution table without editing code, e.g.
# MCP_SOURCE_PATTERNS={"my-host":"my-label"}
