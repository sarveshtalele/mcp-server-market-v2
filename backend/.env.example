# Copy to backend/.env and fill in your values.

# OpenAI-compatible LLM gateway (e.g. a LiteLLM proxy).
# Clients call LLM_BASE_URL + /v1/chat/completions.
# The LLM_ prefix avoids clashing with any ANTHROPIC_* vars in your OS env.
LLM_API_KEY=sk-...
LLM_BASE_URL=https://your-litellm-proxy.example.net

# Model id as configured on your proxy (run GET /v1/models to list them).
# Reasoning models share their token budget with the answer — keep this high.
LLM_MODEL=claude-sonnet-4-6
MAX_TOKENS=4096

# Data API location (the MCP server calls this).
DATA_API_BASE_URL=http://127.0.0.1:8000
DATA_API_PORT=8000

# AG-UI agent port (CopilotKit connects here).
AGUI_PORT=8001
